# Copy this file to .env and fill in the values. Never commit .env.

# Pexels (free, requires an account): https://www.pexels.com/api/
PEXELS_API_KEY=

# Voice provider: MiniMax (https://platform.minimax.io).
# Only needed when running outside Claude Code. In Claude Code cloud sessions,
# store the key in the environment's API credentials for api.minimax.io
# (header Authorization, prefix Bearer) and start a new session afterwards.
# MINIMAX_API_KEY=

# Script generation with an LLM (optional, later phase)
# ANTHROPIC_API_KEY=

# TikTok Content Posting API (later phase, requires an approved app)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Optional: override FFmpeg location if it is not on PATH
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
