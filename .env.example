# Copy this file to .env and fill in the values. Never commit .env.

# Pexels (free, requires an account): https://www.pexels.com/api/
PEXELS_API_KEY=

# Voice provider (to be decided). Leave empty until a provider is chosen.
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Script generation with an LLM (optional, later phase)
# ANTHROPIC_API_KEY=

# Automatic publishing (later phase; publishing is manual for now). See docs/MULTIPLATAFORMA.md.
# TikTok Content Posting API (requires an approved app)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Instagram Platform content publishing (Meta app, professional account)
# META_APP_ID=
# META_APP_SECRET=
# YouTube Data API v3 (Google Cloud project with OAuth)
# YOUTUBE_CLIENT_SECRETS_FILE=

# Optional: override FFmpeg location if it is not on PATH
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
