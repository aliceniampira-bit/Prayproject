# Copy this file to .env and fill in the values. Never commit .env.

# Pexels (free, requires an account): https://www.pexels.com/api/
PEXELS_API_KEY=

# Voice provider (to be decided). Leave empty until a provider is chosen.
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Script generation with an LLM (optional, later phase)
# ANTHROPIC_API_KEY=

# TikTok Content Posting API (later phase, requires an approved app)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Optional: override FFmpeg location if it is not on PATH
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
